{
 "title": "CloudPulse LLM & Security",
 "uid": "cloudpulse-main",
 "schemaVersion": 39,
 "refresh": "10s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "LLM requests / min by provider",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "datasource": "Prometheus",
   "targets": [
    {
     "expr": "sum by (provider) (rate(cp_llm_requests_total[5m]))*60",
     "legendFormat": "{{provider}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "p95 latency",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    }
   },
   "datasource": "Prometheus",
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(cp_llm_latency_seconds_bucket[5m])))",
     "legendFormat": "{{provider}}"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Estimated spend (USD/hour)",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    }
   },
   "datasource": "Prometheus",
   "targets": [
    {
     "expr": "sum by (provider) (increase(cp_llm_cost_usd_total[1h]))",
     "legendFormat": "{{provider}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Cache hit ratio",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    }
   },
   "datasource": "Prometheus",
   "targets": [
    {
     "expr": "sum(rate(cp_llm_requests_total{cache=\"true\"}[5m])) / sum(rate(cp_llm_requests_total[5m]))",
     "legendFormat": "hit ratio"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Failovers",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "datasource": "Prometheus",
   "targets": [
    {
     "expr": "sum(rate(cp_llm_requests_total{failover=\"true\"}[5m]))*60",
     "legendFormat": "failovers/min"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Prompts blocked by firewall",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    }
   },
   "datasource": "Prometheus",
   "targets": [
    {
     "expr": "sum by (reason) (increase(cp_guard_blocks_total[1h]))",
     "legendFormat": "{{reason}}"
    }
   ]
  }
 ]
}